arget="node:lab"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge:2:lab:ionos" value="promote" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;fontColor=#0f766e;fontSize=12;strokeWidth=3;endArrow=block;" parent="1" edge="1" source="node:lab" target="node:ionos"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge:3:ionos:sites" value="serve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;fontColor=#0f766e;fontSize=12;strokeWidth=3;endArrow=block;" parent="1" edge="1" source="node:ionos" target="node:sites"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge:4:channel:git_revision" value="record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=12;strokeWidth=3;endArrow=block;" parent="1" edge="1" source="node:channel" target="node:git_revision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge:5:bkc:backup" value="backup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=12;strokeWidth=3;endArrow=block;" parent="1" edge="1" source="node:bkc" target="node:backup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge:6:sites:telemetry" value="observe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=12;strokeWidth=3;endArrow=block;" parent="1" edge="1" source="node:sites" target="node:telemetry"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge:7:telemetry:fragments" value="record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=12;strokeWidth=3;endArrow=block;" parent="1" edge="1" source="node:telemetry" target="node:fragments"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="callout:safe_promotion" value="&lt;b&gt;Safe promotion&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#334155'&gt;Backup, lab smoke, public smoke, rollback path, then receipts.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#2f855a;fontColor=#14532d;fontSize=13;arcSize=10;" parent="1" vertex="1"><mxGeometry x="116" y="875" width="460" height="90" as="geometry" /></mxCell><mxCell id="callout:controlled_transport" value="&lt;b&gt;Controlled transport&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#334155'&gt;IPFire, routed lab edges and DNS/API work are explicit pipeline subjects.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b7791f;fontColor=#5f370e;fontSize=13;arcSize=10;" parent="1" vertex="1"><mxGeometry x="730" y="875" width="460" height="90" as="geometry" /></mxCell><mxCell id="callout:ai_truth_boundary" value="&lt;b&gt;Evidence loop&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#334155'&gt;AI can assist layout. Fragments and receipts teach future runs without changing truth.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#3b0764;fontSize=13;arcSize=10;" parent="1" vertex="1"><mxGeometry x="1340" y="875" width="460" height="90" as="geometry" /></mxCell><mxCell id="caption" value="Generated from BKC evidence. AI assisted grouping; human review accepted the presentation layout." style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#486581;align=left;" parent="1" vertex="1"><mxGeometry x="70" y="1004" width="900" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>